int* asteroidCollision(int* asteroids, int asteroidsSize, int* returnSize) {

    int i=0;
    int j=1;
    int l=0;
    int *ptr;

    ptr=(int*) malloc (10000 * sizeof(int));

    while( j<asteroidsSize){

        if(asteroids[j]>0){
            j++;
            i=j-1;
        }

        else{

            if(i<0){
                j++;
                i=j-1;
            }

            else if(asteroids[i]==0)
            i--;

            else if(asteroids[i]<0 && asteroids[j]<0)
            j++;

        else if((asteroids[j] + asteroids[i])==0){

            asteroids[i]=0;
            asteroids[j]=0;
            j++;
        }

        else if((asteroids[j] + asteroids[i])>0 ){
            asteroids[j]=0;
            j++;
        }

            else{
            asteroids[i]=0;
            }
        }
    }

j=0;
    while(j < asteroidsSize){

        if(asteroids[j]!=0){

            ptr[l]=asteroids[j];
            l++;
        }

        j++;
    }

    *returnSize=l;

    return ptr;
      
}
