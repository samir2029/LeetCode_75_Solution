int largestAltitude(int* gain, int gainSize) {

    int i=0;
    int j=0;
    int s1[gainSize+1];


    s1[0]=0;

    for(int j=0; j<gainSize; j++){

        i++;
        s1[i]=s1[i-1] + gain[j];
    }

    int max=0;

    for(int k=0; k<=gainSize; k++){

        if(max<s1[k])
        max=s1[k];

    }

    return max;
    
}
