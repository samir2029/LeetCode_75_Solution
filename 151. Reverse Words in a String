char* reverseWords(char* s) {

    int i=0, o=0; 
    int *index;
    char *new;

    index= (int*) malloc (10000* sizeof(int));
    new= (char*) malloc (10000* sizeof(char));
    
    index[0]=1;
    o++;
    
    
    while(s[i]!='\0'){
        
        if(i==0){
            
            if( (s[i]>='a' && s[i]<='z') || (s[i]>='A' && s[i]<='Z') || (s[i]>='0' && s[i]<='9') ){

                index[o]=0;
                o++;
                }
                }
                
                else if(s[i]!=' ' && s[i-1]==' '){
                    index[o]=i;
                    o++;
                    }
                    
                    i++;
                    }
                    
                    int k=o-1;
                    int m=0;
                    
                    for(int j=index[k]; j>=-2; j++){
                        
                        if(k==0){
                            k=9;
                            break;
                            }
                            
                            else if(s[j]==' ' || s[j]=='\0'){
                                new[m]=' ';
                                m++;
                                
                                k--;
                                j=index[k];
                                j--;
                                }
                                
                                else if (s[j]!=' '){
                                    new[m]=s[j];
                                    m++;
                                    }
                                    }
                                    
                                    new[m-1]='\0';
                                    
                                    return new;
                                    
                                    }

